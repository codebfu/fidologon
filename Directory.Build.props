<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>

    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <Product>FidoLogon</Product>
    <Company>FidoLogon contributors</Company>
    <Authors>FidoLogon contributors</Authors>
    <Copyright>GPL-3.0-or-later</Copyright>

    <!-- Output folder of the native CMake build (fidologon_native.dll, lock helper, ...). -->
    <NativeBinDir Condition="'$(NativeBinDir)' == ''">$(MSBuildThisFileDirectory)build\native</NativeBinDir>
  </PropertyGroup>
</Project>

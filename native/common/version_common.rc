// Shared VERSIONINFO block. Each target defines FL_FILE_DESCRIPTION,
// FL_ORIGINAL_FILENAME and FL_FILE_TYPE before including this file.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FIDOLOGON_VERSION_MAJOR,FIDOLOGON_VERSION_MINOR,FIDOLOGON_VERSION_PATCH,0
 PRODUCTVERSION FIDOLOGON_VERSION_MAJOR,FIDOLOGON_VERSION_MINOR,FIDOLOGON_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE FL_FILE_TYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FidoLogon contributors"
            VALUE "FileDescription", FL_FILE_DESCRIPTION
            VALUE "FileVersion", FIDOLOGON_VERSION_STRING
            VALUE "InternalName", FL_ORIGINAL_FILENAME
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", FL_ORIGINAL_FILENAME
            VALUE "ProductName", "FidoLogon"
            VALUE "ProductVersion", FIDOLOGON_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

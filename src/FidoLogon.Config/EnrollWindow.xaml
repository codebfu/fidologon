<Window x:Class="FidoLogon.Config.EnrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a security key" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
  <StackPanel Margin="16">
    <TextBlock Text="Account" FontWeight="SemiBold" />
    <ComboBox x:Name="AccountCombo" DisplayMemberPath="DisplayName" Margin="0,4,0,12" />

    <TextBlock Text="Security key" FontWeight="SemiBold" />
    <DockPanel Margin="0,4,0,2">
      <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefreshDevicesClicked" Margin="8,0,0,0" />
      <ComboBox x:Name="DeviceCombo" DisplayMemberPath="DisplayName" SelectionChanged="OnDeviceChanged" />
    </DockPanel>
    <TextBlock x:Name="DeviceInfo" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12" />

    <TextBlock Text="Key name (optional)" FontWeight="SemiBold" />
    <TextBox x:Name="LabelBox" Margin="0,4,0,12" />

    <TextBlock Text="Sign-in mode" FontWeight="SemiBold" />
    <RadioButton x:Name="PinModeRadio" Content="Key PIN + touch (recommended)" IsChecked="True" Margin="0,4,0,0" />
    <RadioButton x:Name="TouchModeRadio" Content="Touch only — anyone holding the key can sign in" Margin="0,4,0,12" />

    <TextBlock Text="When this key is removed" FontWeight="SemiBold" />
    <ComboBox x:Name="RemovalCombo" SelectedIndex="0" Margin="0,4,0,12">
      <ComboBoxItem Content="Use the default option (shown in the main window)" />
      <ComboBoxItem Content="Lock the session" />
      <ComboBoxItem Content="Do nothing" />
    </ComboBox>

    <TextBlock Text="Current Windows password of the account" FontWeight="SemiBold" />
    <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12" />

    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="EnrollButton" Content="Enroll" IsDefault="True" Click="OnEnrollClicked" />
      <Button Content="Cancel" IsCancel="True" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>

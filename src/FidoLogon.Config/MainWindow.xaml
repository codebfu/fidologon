<Window x:Class="FidoLogon.Config.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FidoLogon configuration" Width="860" Height="520" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="FidoLogon" FontSize="22" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Foreground="#555"
                 Text="Sign in to local Windows accounts with a FIDO2 security key. By default, the session locks when the key that opened it is removed." />
    </StackPanel>

    <GroupBox DockPanel.Dock="Bottom" Header="Options" Margin="0,12,0,0" Padding="8">
      <StackPanel>
        <CheckBox x:Name="FallbackCheckBox" Content="Allow signing in with the Windows password (recommended)"
                  Click="OnFallbackClicked" />
        <TextBlock x:Name="FallbackWarning" TextWrapping="Wrap" Margin="20,4,0,0" Foreground="#A05A00"
                   Visibility="Collapsed" />
        <CheckBox x:Name="LockCheckBox" Margin="0,8,0,0"
                  Content="Lock the session when the key that opened it is removed (recommended)"
                  Click="OnLockClicked" />
        <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" Foreground="#555"
                   Text="Default for every key. A key can override it with &quot;On removal&quot; below the list." />
      </StackPanel>
    </GroupBox>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Add key…" Click="OnAddClicked" />
      <Button x:Name="TestButton" Content="Test…" Click="OnTestClicked" IsEnabled="False" />
      <Button x:Name="RemoveButton" Content="Remove" Click="OnRemoveClicked" IsEnabled="False" />
      <Button Content="Refresh" Click="OnRefreshClicked" />
      <Button Content="Key models…" Click="OnModelsClicked" />
      <TextBlock Text="On removal:" VerticalAlignment="Center" Margin="8,0,4,0" />
      <ComboBox x:Name="RemovalCombo" Width="150" IsEnabled="False" SelectionChanged="OnRemovalChanged">
        <ComboBoxItem Content="Use default" />
        <ComboBoxItem Content="Lock session" />
        <ComboBoxItem Content="Do nothing" />
      </ComboBox>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555" />
    </StackPanel>

    <DataGrid x:Name="KeysGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              HeadersVisibility="Column" CanUserAddRows="False" SelectionChanged="OnSelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Account" Binding="{Binding UserName}" Width="140" />
        <DataGridTextColumn Header="Key" Binding="{Binding Label}" Width="*" />
        <DataGridTextColumn Header="Sign-in" Binding="{Binding Mode}" Width="120" />
        <DataGridTextColumn Header="On removal" Binding="{Binding Removal}" Width="130" />
        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="170" />
        <DataGridTextColumn Header="Enrolled" Binding="{Binding Created}" Width="110" />
        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="280" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

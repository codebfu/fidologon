<Window x:Class="FidoLogon.Config.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allowed key models" Width="820" Height="620" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock TextWrapping="Wrap" Foreground="#555"
                 Text="When this list is not empty, or certified models are allowed, only those key models can be enrolled: the key's attestation must chain to a root certificate published for its model by the FIDO Metadata Service. Keys already enrolled keep working. Otherwise every model is accepted." />
      <DockPanel Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SyncButton" Content="Synchronize" Click="OnSyncClicked" Margin="8,0,0,0"
                  ToolTip="Download the latest metadata from https://mds3.fidoalliance.org/" />
          <Button Content="Import metadata…" Click="OnImportClicked" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="MetadataInfo" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
      <CheckBox x:Name="CertifiedCheckBox" Margin="0,10,0,0" Click="OnCertifiedClicked"
                Content="Also allow every model certified in the FIDO metadata (its attestation is still checked)" />
      <CheckBox x:Name="AutoSyncCheckBox" Margin="0,6,0,0" Click="OnAutoSyncClicked"
                Content="Download new metadata automatically (checked daily by the FidoLogon service)" />
    </StackPanel>

    <GroupBox DockPanel.Dock="Top" Header="Allowed models" Padding="8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="RemoveButton" Content="Remove" Click="OnRemoveClicked" IsEnabled="False" />
        </StackPanel>
        <DataGrid x:Name="AllowedGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" Height="150" SelectionChanged="OnAllowedSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Model" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" />
            <DataGridTextColumn Header="AAGUID" Binding="{Binding Aaguid}" Width="270" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </GroupBox>

    <GroupBox Header="Add a model from the imported metadata" Margin="0,12,0,0" Padding="8">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="AllowButton" Content="Allow" Click="OnAllowClicked" IsEnabled="False" />
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555" />
        </StackPanel>
        <DataGrid x:Name="MetadataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" SelectionChanged="OnMetadataSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Model" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" />
            <DataGridTextColumn Header="AAGUID" Binding="{Binding Aaguid}" Width="270" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </GroupBox>
  </DockPanel>
</Window>

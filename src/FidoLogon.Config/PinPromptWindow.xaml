<Window x:Class="FidoLogon.Config.PinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security key PIN" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=PinBox}">
  <StackPanel Margin="16">
    <TextBlock Text="Enter the PIN of the security key:" />
    <TextBlock x:Name="DetailText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" Visibility="Collapsed" />
    <PasswordBox x:Name="PinBox" Margin="0,8,0,0" />
    <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Firebrick" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" IsDefault="True" Click="OnOkClicked" />
      <Button Content="Cancel" IsCancel="True" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
